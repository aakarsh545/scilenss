{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "proxy": {
    "entrypoint": "proxy.js",
    "matcher": ["/orbit", "/orbit/", "/orbit.html"]
  },
  "rewrites": [
    { "source": "/", "destination": "/index.html" },
    { "source": "/login", "destination": "/login.html" },
    { "source": "/orbit", "destination": "/orbit.html" }
  ]
}
